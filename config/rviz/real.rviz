Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.3
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 50; 50
      Size (m): 0.04
      Style: Flat Squares
      Decay Time: 0
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: Raceline
      Enabled: true
      Color: 0; 170; 255
      Line Style: Lines
      Topic:
        Value: /race/raceline
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Local Path
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /race/local_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: PF Pose
      Enabled: true
      Shape: Arrow
      Color: 255; 170; 0
      Shaft Length: 0.4
      Shaft Radius: 0.04
      Head Length: 0.15
      Head Radius: 0.08
      Covariance:
        Value: true
      Topic:
        Value: /pf/pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Mapping Trajectory
      Enabled: true
      Color: 255; 255; 0
      Line Style: Lines
      Topic:
        Value: /mapping/trajectory
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Pose
      Name: Car Pose
      Enabled: true
      Shape: Arrow
      Color: 255; 85; 0
      Shaft Length: 0.35
      Shaft Radius: 0.03
      Head Length: 0.12
      Head Radius: 0.07
      Topic:
        Value: /race/car_pose
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_link:
          Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
