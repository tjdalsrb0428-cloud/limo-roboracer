# 컨테이너를 호스트 계정(uid)으로 실행할 때 쓰는 bash 설정(/etc/bash.bashrc로 마운트).
source /opt/ros/humble/setup.bash
source /opt/limo_ws/install/setup.bash
# 우리 ROS2 패키지(limo_race) — 컨테이너 작업 폴더(코드 폴더)에 빌드돼 있으면
[ -f "$PWD/install/setup.bash" ] && source "$PWD/install/setup.bash"
# 프롬프트: (limo_race) 노란색 + 경로 파란색 → 컨테이너 안인지 한눈에 구분
PS1='\[\e[01;33m\](limo_race)\[\e[0m\] \[\e[01;34m\]\w\[\e[0m\]\$ '
