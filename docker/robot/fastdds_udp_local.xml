<?xml version="1.0" encoding="UTF-8"?>
<!-- UDP 전용 + 127.0.0.1만 사용. 로봇 드라이버가 ROS_LOCALHOST_ONLY=1일 때 컨테이너도 이걸 써야 데이터가 오간다
     (whitelist 없으면 컨테이너가 Wi-Fi IP로 수신 주소를 알려 → 루프백만 쓰는 호스트가 못 보냄: 토픽 목록만 보이고 데이터 0 Hz, 2026-11-18). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_local</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_local_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>udp_local</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
